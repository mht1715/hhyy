APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=your-secret

# Postgres
POSTGRES_USER=agent_user
POSTGRES_PASSWORD=agent_password
POSTGRES_DB=agent_db
# 在本地直接跑 python 脚本时，用 localhost；在 docker 容器内跑时，用 db
POSTGRES_SERVER=localhost

#Deepseek
DEEPSEEK_API_KEY=your_key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_CHAT_MODEL=deepseek-flash

# 模型调用通用参数
LLM_TEMPERATURE=0.3
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

#Dashscope
DASHSCOPE_API_KEY=your_key
DASHSCOPE_BASE_URL=https://yourdomain.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=10

#Langfuse（可观测，可留空：留空即关闭上报，服务不会因此启动失败）
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

#Milvus
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=

# RAG 检索
RAG_COLLECTION=hhyy_kb_chunks
RETRIEVAL_TOP_K=30
RERANK_TOP_N=5
SCORE_THRESHOLD=0.30
RERANK_MODEL=gte-rerank
RERANK_ENABLED=true

# 记忆
MEMORY_COLLECTION=hhyy_memory
MEMORY_ENABLED=true
MEMORY_TTL_DAYS=180

# 人工介入
HANDOFF_QUEUE_TIMEOUT=90