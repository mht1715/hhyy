APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=your-secret

# Postgres
POSTGRES_USER=agent_user
POSTGRES_PASSWORD=agent_password
POSTGRES_DB=agent_db
# 在本地直接跑 python 脚本时，用 localhost；在 docker 容器内跑时，用 db
POSTGRES_SERVER=localhost

#Deepseek
DEEPSEEK_API_KEY=your_key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_CHAT_MODEL=deepseek-flash

# 模型调用通用参数
LLM_TEMPERATURE=0.3
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

#Dashscope
DASHSCOPE_API_KEY=your_key
DASHSCOPE_BASE_URL=https://yourdomain.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=10

#Langfuse（可观测，可留空：留空即关闭上报，服务不会因此启动失败）
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

#Milvus
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=

# RAG 检索
RAG_COLLECTION=hhyy_kb_chunks
RETRIEVAL_TOP_K=30
RERANK_TOP_N=5
# 余弦相似度阈值：仅当重排不可用、退回 dense 检索时生效（库上可单独配置）
SCORE_THRESHOLD=0.30
# 重排分阈值：与余弦阈值不是一个刻度，别共用（实测无关问题 ≤0.14、相关 ≥0.17）
RERANK_SCORE_THRESHOLD=0.15
# 模型名必须是 gte-rerank-v2；写成 gte-rerank 会 403 AccessDenied
RERANK_MODEL=gte-rerank-v2
RERANK_BASE_URL=https://dashscope.aliyuncs.com
RERANK_ENABLED=true

# 知识库（M1）
# 上传文件落盘目录，相对仓库根（不要写绝对路径，换机器就跑不了）
KB_STORAGE_DIR=backend/static/kb
KB_MAX_FILE_MB=20
KB_CHUNK_MAX_CHARS=800
# ACL 缓存 TTL，对应 PRD「权限变更 ≤30s 生效」
ACL_CACHE_TTL=30

# 多 Agent / 对话（M2）
# Agent 配置缓存 TTL（后台保存后会主动失效，这里只是多 worker 的兜底）
AGENT_REGISTRY_TTL=60
# 单个子 Agent 硬超时：超时就用已得结果作答，不让整条回答挂住
AGENT_TIMEOUT_SECONDS=8
# 对话限流（次/分钟/用户或 IP）
CHAT_RATE_LIMIT_PER_MINUTE=20
# 幂等窗口（秒）：同一 client_message_id 在窗口内重放上次结果
CHAT_IDEMPOTENCY_SECONDS=300
# 带进 prompt 的历史轮数
CHAT_HISTORY_TURNS=6
# supervisor 路由：关掉则「没有 @ 的提问」全部直连主 Agent
SUPERVISOR_ENABLED=true
# 置信度低于该值时先澄清（PRD FR1.4）
SUPERVISOR_CONFIDENCE_FLOOR=0.6
# 多 Agent 汇总是否再花一次模型调用做语言融合（默认关：确定性合并更快且不会张冠李戴）
CHAT_LLM_SYNTHESIS=false

# 记忆（M3）
MEMORY_COLLECTION=hhyy_memory
MEMORY_ENABLED=true
# 语义记忆 TTL：到期后不再召回，但行仍保留（用户仍能看见并删除）
MEMORY_TTL_DAYS=180
# 每次注入 prompt 的记忆条数（PRD FR6.5 的 top 3）
MEMORY_INJECT_LIMIT=3
# 关掉后连后台抽取都不跑（用户级开关在「我的记忆」页面）
MEMORY_EXTRACT_ENABLED=true
# 短期记忆：原文保留轮数 + prompt 历史 token 预算
MEMORY_WINDOW_TURNS=10
MEMORY_HISTORY_BUDGET=1500

# LangGraph checkpointer（M3）：关掉则图状态不落库，对话仍可用
# ⚠️ Windows 上 psycopg 需要 SelectorEventLoop，请用 backend/serve.py 或 uvicorn --reload 启动
CHECKPOINTER_ENABLED=true

# 人工介入（M3）
HANDOFF_QUEUE_TIMEOUT=90
# 连续 N 次拒答 / N 轮负面情绪 → 建议转人工
HANDOFF_REFUSAL_STREAK=2
# WebSocket 短期票据有效期（先 HTTP 拿 ticket，再连 WS，避免 JWT 进 query string）
WS_TICKET_TTL=60
# 服务端心跳间隔：客户端 90s 收不到任何帧就该重连
WS_HEARTBEAT_SECONDS=25