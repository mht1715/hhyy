# =============================================================================
# 花红药业 Agent 平台 · Git 忽略规则
#
# 判定标准只有两条：
#   1. 本机才有 / 含密钥 / 运行时生成 → 一律忽略
#   2. 别人 clone 下来必须能用（.env.example、lock 文件、迁移脚本）→ 必须入库
#
# 改动后请自检：git status --short 不应出现预期之外的文件
# =============================================================================

# ---------- 1. 密钥与本地环境变量 ----------
# .env 里放的是真实的 DeepSeek / DashScope / Langfuse Key，绝对不能入库
.env
.env.*
!.env.example
.envrc

# 证书与私钥（预留：以后接 HTTPS 或第三方支付回调验签会用到）
*.pem
*.key
*.p12
*.pfx

# ---------- 2. 容器数据卷 ----------
# docker compose 挂载出来的 PostgreSQL / Redis / etcd / MinIO / Milvus 数据，
# 体积可达数 GB，且只是本机运行状态
/volumes/

# ---------- 3. Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# 虚拟环境（本项目统一使用仓库根目录的 .venv）
.venv/
venv/
env/
ENV/

# 测试与静态检查缓存
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/
.coverage
.coverage.*
coverage.xml
htmlcov/

# ---------- 4. 前端 ----------
node_modules/
dist/
dist-ssr/
.vite/
*.tsbuildinfo
# Vite 的本地覆盖文件（.env.local、.env.development.local 等）
*.local

# ---------- 5. 后端运行时产物 ----------
# 药品图片上传目录（upload.py 写入 static/uploads），内容是用户上传的文件
/backend/static/
/backend/app/static/

# ---------- 6. 数据库与日志 ----------
*.sqlite3
db.sqlite3
*.db
*.db-journal
*.log
logs/
*.pid
*.rdb
*.aof

# ---------- 7. 工具产物 ----------
# CodeGraph 本地索引：每台机器各自 build，同步到仓库只会制造无意义的冲突
.codegraph/

# ---------- 8. 编辑器与操作系统 ----------
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.sw?
